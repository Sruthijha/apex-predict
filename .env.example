# ---- Backend (FastAPI) ----

# SQLite for zero-setup local dev; swap for a Postgres URL in production.
# e.g. postgresql+psycopg2://user:password@host:5432/apex_predict
DATABASE_URL=sqlite:///./apex_predict.db

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000

# Jolpica-F1 (Ergast-compatible) historical data API base URL.
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# Directory used to cache raw API responses so the app keeps working if the
# external API is unreachable.
DATA_CACHE_DIR=../data/raw

# Directory holding the cleaned parquet tables produced by
# backend/scripts/build_processed_data.py.
PROCESSED_DATA_DIR=../data/processed

# Path to the trained model artifact bundle produced by backend/scripts/train.py
MODEL_ARTIFACT_DIR=../data/models

# Random seed for reproducible Monte Carlo simulation defaults.
SIMULATION_SEED=42

# ---- Frontend (Next.js) ----

# Base URL the frontend uses to call the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
